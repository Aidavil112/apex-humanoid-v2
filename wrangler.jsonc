{
  "name": "apex-humanoid-v2",
  "main": "cloudflare-bot/worker.js",
  "compatibility_date": "2025-01-01",
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "kv_namespaces": [
