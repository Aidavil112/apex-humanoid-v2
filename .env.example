# ---------------------------------------------------------------------------
# APEX Humanoid — environment variables
# Copy karo:  cp .env.example .env   (phir values bharo)
# .env NEVER commit karna — .gitignore me already blocked hai
# ---------------------------------------------------------------------------

# ---------- Telegram bot (optional) ----------
# @BotFather -> /newbot -> token
TELEGRAM_BOT_TOKEN=
# webhook mode ke liye random string (koi bhi: openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=
# lock bot to specific chats (comma separated) — /whoami se id milega
TELEGRAM_ALLOWED_CHATS=
# "poll" (default) ya "webhook"
TELEGRAM_MODE=poll

# ---------- AI brain (optional, ek hi kaafi hai) ----------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---------- Voice (optional) ----------
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_turbo_v2_5
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ---------- Trading (optional — warna demo/sandbox mode) ----------
COINDCX_API_KEY=
COINDCX_API_SECRET=
COINDCX_BASE_URL=https://api.coindcx.com

# ---------- 3D printer (optional) ----------
# PRINTER_URL=http://192.168.1.50
# PRINTER_KIND=octoprint

# ---------- Android / Play Store TWA (optional) ----------
ANDROID_PACKAGE_NAME=com.aidavil.apexhumanoid
ANDROID_SHA256_FINGERPRINTS=

# ---------- Server ----------
# PORT=3000
# NODE_ENV=production
